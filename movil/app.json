{
  "expo": {
    "name": "HoudiniApp",
    "slug": "houdiniapp",
    "scheme": "houdiniapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1220",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.houdiniapp.movil"
    },
    "android": {
      "package": "com.houdiniapp.movil",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0d1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-secure-store",
      "expo-asset",
      ["expo-audio", { "microphonePermission": false }],
      ["expo-location", {
        "locationWhenInUsePermission": "HoudiniApp usa tu ubicación para activar tus reglas y avisar a tus cómplices."
      }],
      ["expo-sensors", {
        "motionPermission": "HoudiniApp usa el movimiento para activar el escape al agitar y detectar el teléfono en tu oído."
      }],
      "expo-notifications"
    ]
  }
}
